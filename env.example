# Required backend settings
FINTRACK_DB_PATH=/absolute/path/to/Fintrack-Ai/fintrackai.db
FINTRACK_SECRET_KEY=replace-with-at-least-32-random-characters
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME="FinTrack AI"

# Optional security and SQLite settings
FINTRACK_OTP_TTL_SECONDS=300
FINTRACK_OTP_RESEND_COOLDOWN_SECONDS=60
FINTRACK_OTP_MAX_ATTEMPTS=5
FINTRACK_SESSION_TTL_SECONDS=86400
FINTRACK_SQLITE_BUSY_TIMEOUT_MS=5000
